# ========================================================
# CẤU HÌNH BOT TELEGRAM (MIỄN PHÍ 100%)
# ========================================================
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ========================================================
# CẤU HÌNH GOOGLE GEMINI AI (MIỄN PHÍ 100% - FREE TIER)
# ========================================================
# Lấy API Key miễn phí không cần thẻ tín dụng tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_free_api_key
GEMINI_MODEL=gemini-3.8-flash

# ========================================================
# CẤU HÌNH LẬP LỊCH TỰ ĐỘNG CHẠY HÀNG NGÀY (CRON)
# ========================================================
CRON_SCHEDULE="0 8 * * *"
TIMEZONE="Asia/Ho_Chi_Minh"

# ========================================================
# CƠ SỞ DỮ LIỆU CỤC BỘ (100% MIỄN PHÍ - KHÔNG CẦN CẤU HÌNH)
# ========================================================
# Để trống thì bot tự động dùng data/local_db.json miễn phí 100%.
SUPABASE_URL=
SUPABASE_KEY=

# ========================================================
# QUÉT XU HƯỚNG TIKTOK & META ADS (TÙY CHỌN)
# ========================================================
# Để trống: Tự động dùng Google Trends RSS miễn phí 100%.
APIFY_TOKEN=

# ========================================================
# GOOGLE SHEETS (TÙY CHỌN)
# ========================================================
GOOGLE_SHEET_ID=
